{
  "families": {
    "dataSource": {
      "MODBUS_IP.DS": {
        "type": "object",
        "properties": {
          "connectionDescription": {
            "$ref": "#/components/schemas/MessageTranslation"
          },
          "description": {
            "$ref": "#/components/schemas/MessageTranslation"
          },
          "purgeOverride": {
            "type": "boolean",
            "description": "When true, this data source uses its own purgePeriod instead of the system default retention."
          },
          "purgePeriod": {
            "$ref": "#/components/schemas/TimePeriod"
          },
          "editPermission": {
            "type": "string",
            "description": "Permission group(s) allowed to edit this data source, comma-separated."
          },
          "enabled": {
            "type": "boolean"
          },
          "alarmLevels": {
            "type": "array",
            "description": "Per-event-type alarm level overrides for this data source's built-in event types.",
            "items": {
              "$ref": "#/components/schemas/EventTypeAlarmLevelModel"
            }
          },
          "quantize": {
            "type": "boolean",
            "description": "When true, polls are aligned to the boundaries of the update period rather than to the source's start time."
          },
          "timePeriod": {
            "$ref": "#/components/schemas/TimePeriod"
          },
          "timeout": {
            "type": "integer",
            "description": "Response timeout in milliseconds for each Modbus request.",
            "format": "int32",
            "example": 500
          },
          "retries": {
            "type": "integer",
            "description": "Number of retries per request before giving up.",
            "format": "int32",
            "example": 2
          },
          "multipleWritesOnly": {
            "type": "boolean",
            "description": "Always use multi-register write function codes, even for single-value writes."
          },
          "contiguousBatches": {
            "type": "boolean",
            "description": "Only batch reads across registers that are contiguous."
          },
          "createSlaveMonitorPoints": {
            "type": "boolean",
            "description": "Auto-create points that monitor each slave's online/offline status."
          },
          "maxReadBitCount": {
            "type": "integer",
            "description": "Maximum number of bits/coils read in a single request.",
            "format": "int32",
            "example": 2000
          },
          "maxReadRegisterCount": {
            "type": "integer",
            "description": "Maximum number of registers read in a single request.",
            "format": "int32",
            "example": 125
          },
          "maxWriteRegisterCount": {
            "type": "integer",
            "description": "Maximum number of registers written in a single request.",
            "format": "int32",
            "example": 120
          },
          "discardDataDelay": {
            "type": "integer",
            "description": "Discard polled data older than this delay before publishing it.",
            "format": "int32"
          },
          "logIO": {
            "type": "boolean",
            "description": "Enable low-level Modbus I/O logging for this data source."
          },
          "ioLogFileSizeMBytes": {
            "type": "number",
            "description": "Maximum size of each I/O log file, in megabytes.",
            "format": "float",
            "example": 1
          },
          "maxHistoricalIOLogs": {
            "type": "integer",
            "description": "Number of rotated I/O log files to retain.",
            "format": "int32",
            "example": 1
          },
          "transportType": {
            "type": "string",
            "description": "IP transport protocol used to reach the device.",
            "example": "TCP",
            "enum": [
              "TCP",
              "TCP_KEEP_ALIVE",
              "UDP"
            ]
          },
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "int32"
          },
          "encapsulated": {
            "type": "boolean",
            "description": "Use RTU-over-TCP (encapsulated) framing instead of native Modbus/TCP."
          },
          "lingerTime": {
            "type": "integer",
            "description": "Socket SO_LINGER time in seconds; -1 leaves the OS default.",
            "format": "int32",
            "example": -1
          },
          "scaleFactor": {
            "type": "number",
            "description": "Multiplier that grows the reconnect back-off period after repeated failures.",
            "format": "float",
            "example": 1.5
          },
          "maxBackOffPeriod": {
            "$ref": "#/components/schemas/TimePeriod"
          },
          "maxConcurrentConnections": {
            "type": "integer",
            "description": "Maximum concurrent TCP connections to the device; 0 means unlimited.",
            "format": "int32",
            "example": 0
          },
          "modelType": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "description": "ID of object in database",
            "format": "int32"
          },
          "xid": {
            "type": "string",
            "description": "XID of object"
          },
          "name": {
            "type": "string",
            "description": "Name of object"
          }
        }
      }
    },
    "pointLocator": {
      "MODBUS.PL": {
        "type": "object",
        "properties": {
          "dataType": {
            "type": "string",
            "description": "Data type of the value at this point.",
            "enum": [
              "BINARY",
              "MULTISTATE",
              "NUMERIC",
              "ALPHANUMERIC",
              "IMAGE"
            ]
          },
          "settable": {
            "type": "boolean"
          },
          "relinquishable": {
            "type": "boolean",
            "description": "Whether a set value can be relinquished back to the device's own control (e.g. BACnet priority array)."
          },
          "configurationDescription": {
            "$ref": "#/components/schemas/MessageTranslation"
          },
          "range": {
            "type": "string",
            "description": "Modbus register range this point reads from.",
            "example": "HOLDING_REGISTER",
            "enum": [
              "COIL_STATUS",
              "INPUT_STATUS",
              "HOLDING_REGISTER",
              "INPUT_REGISTER"
            ]
          },
          "modbusDataType": {
            "type": "string",
            "description": "Modbus data-type code used to decode the raw registers.",
            "example": "FOUR_BYTE_FLOAT"
          },
          "slaveId": {
            "type": "integer",
            "description": "Modbus slave/unit id (0-255).",
            "format": "int32",
            "example": 1
          },
          "slaveMonitor": {
            "type": "boolean",
            "description": "Whether this point monitors the slave's online/offline status rather than a register value."
          },
          "offset": {
            "type": "integer",
            "description": "Zero-based register/coil offset within the slave.",
            "format": "int32"
          },
          "bit": {
            "type": "string",
            "description": "Bit index within the register, used for the BINARY data type.",
            "format": "byte"
          },
          "registerCount": {
            "type": "integer",
            "description": "Number of 16-bit registers spanned, used for CHAR/VARCHAR data types.",
            "format": "int32"
          },
          "charset": {
            "type": "string",
            "description": "Charset used to decode CHAR/VARCHAR values.",
            "example": "ASCII"
          },
          "writeType": {
            "type": "string",
            "description": "Whether/how the point may be written back to the device.",
            "example": "SETTABLE",
            "enum": [
              "NOT_SETTABLE",
              "SETTABLE",
              "WRITE_ONLY"
            ]
          },
          "multiplier": {
            "type": "number",
            "description": "Multiplier applied to the raw value: rendered = raw * multiplier + additive.",
            "format": "double",
            "example": 1
          },
          "additive": {
            "type": "number",
            "description": "Additive offset applied after the multiplier.",
            "format": "double",
            "example": 0
          },
          "multistateNumeric": {
            "type": "boolean",
            "description": "Render the value as a multistate point instead of numeric."
          },
          "rangeId": {
            "type": "integer",
            "format": "int32"
          },
          "modelType": {
            "type": "string"
          },
          "modbusDataTypeId": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    },
    "eventDetector": {
      "BINARY_STATE_DETECTOR": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "description": "Xid of the data point the detector monitors."
          },
          "description": {
            "$ref": "#/components/schemas/MessageTranslation"
          },
          "rtnApplicable": {
            "type": "boolean",
            "description": "Whether the detector produces a return-to-normal (inactive) transition when the condition clears."
          },
          "alarmLevel": {
            "type": "string",
            "description": "Alarm level raised when the detector trips.",
            "enum": [
              "NONE",
              "INFORMATION",
              "WARNING",
              "URGENT",
              "CRITICAL",
              "EMERGENCY",
              "DO_NOT_LOG",
              "IGNORE"
            ]
          },
          "sourceTypeName": {
            "type": "string",
            "description": "Source type of the detector (the kind of object being monitored)."
          },
          "handlerXids": {
            "type": "array",
            "description": "Xids of the event handlers invoked when this detector raises an event.",
            "items": {
              "type": "string",
              "description": "Xids of the event handlers invoked when this detector raises an event."
            }
          },
          "dataPoint": {
            "$ref": "#/components/schemas/DataPointModel"
          },
          "duration": {
            "$ref": "#/components/schemas/TimePeriod"
          },
          "state": {
            "type": "boolean",
            "description": "Boolean value the point must hold for the detector to trip."
          },
          "detectorType": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "description": "ID of object in database",
            "format": "int32"
          },
          "xid": {
            "type": "string",
            "description": "XID of object"
          },
          "name": {
            "type": "string",
            "description": "Name of object"
          }
        }
      }
    },
    "eventHandler": {
      "EMAIL_HANDLER": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/AbstractEventHandlerModel"
          },
          {
            "type": "object",
            "properties": {
              "disabled": {
                "type": "boolean",
                "description": "Whether this handler is disabled and will not run."
              },
              "eventTypes": {
                "type": "array",
                "description": "Event type matchers that determine which events trigger this handler.",
                "items": {
                  "$ref": "#/components/schemas/EventTypeMatcherModel"
                }
              },
              "activeRecipients": {
                "type": "array",
                "description": "Recipients emailed when a matching event becomes active.",
                "items": {
                  "$ref": "#/components/schemas/RecipientEntryModel"
                }
              },
              "sendEscalation": {
                "type": "boolean",
                "description": "Whether escalation emails are sent if the event stays active past the escalation period."
              },
              "escalationPeriod": {
                "$ref": "#/components/schemas/TimePeriod"
              },
              "escalationRecipients": {
                "type": "array",
                "description": "Recipients emailed on escalation.",
                "items": {
                  "$ref": "#/components/schemas/RecipientEntryModel"
                }
              },
              "sendInactive": {
                "type": "boolean",
                "description": "Whether an email is sent when the event returns to normal (inactive)."
              },
              "inactiveOverride": {
                "type": "boolean",
                "description": "When true, inactive notifications go to inactiveRecipients instead of the active recipients."
              },
              "inactiveRecipients": {
                "type": "array",
                "description": "Recipients emailed when the event returns to normal, when inactiveOverride is set.",
                "items": {
                  "$ref": "#/components/schemas/RecipientEntryModel"
                }
              },
              "customTemplate": {
                "type": "string",
                "description": "Custom email body template; when null the default template is used."
              },
              "subject": {
                "type": "string",
                "description": "Coded email subject-line style."
              },
              "handlerType": {
                "type": "string"
              },
              "id": {
                "type": "integer",
                "description": "ID of object in database",
                "format": "int32"
              },
              "xid": {
                "type": "string",
                "description": "XID of object"
              },
              "name": {
                "type": "string",
                "description": "Name of object"
              }
            }
          }
        ]
      }
    }
